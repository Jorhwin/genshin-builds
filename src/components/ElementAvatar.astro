---
export interface Props {
  element: string;
  name: string;
}

const { element, name } = Astro.props;
const el = String(element || "").toLowerCase();
const initial = String(name || "?").charAt(0).toUpperCase();

// Original abstract element glyphs built from public-domain basic shapes
// (flame / droplet / leaf / wind strokes / bolt / crystal / snowflake).
// These are generic geometry, NOT reproductions of any official artwork.
const ICONS = {
  pyro: {
    fill: "M12 22.2c4 0 7.2-3.1 7.2-7 0-4.7-4.5-8.4-7.2-13.4-2.7 5-7.2 8.7-7.2 13.4 0 3.9 3.2 7 7.2 7z",
  },
  hydro: {
    fill: "M12 3.4 6.9 10.7a6.9 6.9 0 1 0 10.2 0L12 3.4z",
  },
  dendro: {
    fill: "M20.6 3.4c-9.6 0-16.4 4.9-16.4 11.9a4.9 4.9 0 0 0 4.9 4.9c7.1 0 11.5-7.1 11.5-16.8z",
  },
  electro: {
    fill: "M13.8 2.4 5.4 13.9h5.3L9.5 21.6l8.8-11.6h-5.5l1-7.6z",
  },
  anemo: {
    stroke: "M3.2 8h10.3a3 3 0 1 0-3-3M3.2 12h13.8a3 3 0 1 1-3 3M3.2 16h8.4",
  },
  geo: {
    stroke: "M12 2.6 3.9 9.1 12 21.4l8.1-12.3L12 2.6zM3.9 9.1h16.2M12 2.6v18.8",
  },
  cryo: {
    stroke:
      "M12 2.4v19.2M3.8 7.1l16.4 9.8M3.8 16.9l16.4-9.8M12 6.6 9.9 4.5M12 6.6l2.1-2.1M12 17.4l-2.1 2.1M12 17.4l2.1 2.1",
  },
};

const icon = ICONS[el] || ICONS.pyro;
---

<span class={"avatar avatar-" + el + " ea"}>
  <svg class="ea-glyph" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
    {
      icon.fill ? (
        <path d={icon.fill} fill="currentColor" />
      ) : (
        <path
          d={icon.stroke}
          fill="none"
          stroke="currentColor"
          stroke-width="1.9"
          stroke-linecap="round"
          stroke-linejoin="round"
        />
      )
    }
  </svg>
  <span class="ea-initial">{initial}</span>
</span>

<style>
  .ea {
    position: relative;
    overflow: hidden;
  }

  .ea-glyph {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 84%;
    height: 84%;
    color: #000;
    opacity: 0.17;
    pointer-events: none;
  }

  .ea-initial {
    position: relative;
    z-index: 1;
    font-size: inherit;
    font-weight: 800;
    line-height: 1;
    color: #0a0a12;
  }
</style>
