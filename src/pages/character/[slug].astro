---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { characters } from "../../data/characters";
import { coreInsights } from "../../data/insights";
import { extendedGuides } from "../../data/extended-guides";
import { bestLists } from "../../data/best-lists";

export function getStaticPaths() {
  return characters.map((c) => ({
    params: { slug: c.slug },
    props: { character: c },
  }));
}

const { character: c } = Astro.props;
const relatedLists = bestLists.filter((b) => b.items.some((i) => i.slug === c.slug));
const title = c.name + " Best Build & Weapons Guide (2026) - Artifacts, Teams & Rotation";
const description = c.name + " best build guide for 2026. Top weapon: " + c.bestWeapon + " | F2P: " + c.f2pWeapon + " | Best artifacts: " + c.bestArtifacts + ". Complete stats, team comps & rotation guide included.";
const jsonld = JSON.stringify({"@context":"https://schema.org","@type":"Article","headline":title,"description":description,"about":{"@type":"Thing","name":c.name}});
const faq = [
  {
    q: "What is the best build for " + c.name + "?",
    a: "The best " + c.name + " build uses " + c.bestWeapon + " with " + c.bestArtifacts + ". Main stats: " + c.mainStats + ". This setup maximizes their damage and keeps their rotation smooth."
  },
  {
    q: "Is " + c.name + " good in the current meta?",
    a: c.rating + " " + c.name + " is a " + c.role + " that works well in " + c.strongTeam + ". They remain a strong pick in current abyss rotations."
  },
  {
    q: "What is the best F2P weapon for " + c.name + "?",
    a: "The best free-to-play weapon for " + c.name + " is " + c.f2pWeapon + ". It provides competitive damage without requiring the weapon banner, making it a great budget option."
  },
  {
    q: "What is the recommended rotation for " + c.name + "?",
    a: "The recommended rotation is: " + c.rotation + ". Practicing this order ensures " + c.name + " snapshots buffs and maximizes their damage window."
  }
];
const faqJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map(f => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a }
  }))
});
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={jsonld}></script>
  <script type="application/ld+json" set:html={faqJsonLd}></script>
  <p>
    <span class={"tag tag-" + c.tier}>{c.tier}</span>
    <span class={"tag tag-" + c.element.toLowerCase()}>{c.element}</span>
    <span style="color: var(--text-muted);">{c.role} &middot; {c.weapon}</span>
  </p>
  <h1>{c.name} Build Guide</h1>
  <p>{c.description}</p>

  {coreInsights[c.slug] && (
    <div class="insight-box">
      <h3>Why This Build Works</h3>
      <p>{coreInsights[c.slug].whyItWorks}</p>
      <h3>Key Stat Threshold</h3>
      <p>{coreInsights[c.slug].keyThreshold}</p>
      <h3>Current Meta Status</h3>
      <p>{coreInsights[c.slug].metaStatus}</p>
    </div>
  )}

  <h2>Gameplay Strategy</h2>
  <div class="card">
    <p>{c.name} functions best as a {c.role}. The key to mastering this character is understanding how their kit interacts with the current abyss meta. Below are the critical gameplay patterns you need to know.</p>
    <h3>Rotation Tips</h3>
    <p>{c.rotation}</p>
    <h3>Team Synergy</h3>
    <p>{c.teamRole} In practice, this means pairing them with characters that complement their strengths and cover their weaknesses.</p>
  </div>

  <h2>Build Comparison: Entry vs Endgame</h2>
  <div class="stat-grid">
    <div class="stat-card">
      <div class="stat-label">Entry Level Build</div>
      <div class="stat-value">{c.f2pWeapon}</div>
      <p style="margin-top: 4px;">Focus on main stat correctness. Set bonuses matter less than having correct main stats.</p>
    </div>
    <div class="stat-card">
      <div class="stat-label">Endgame Build</div>
      <div class="stat-value">{c.bestWeapon}</div>
      <p style="margin-top: 4px;">Optimize substats for perfect ratio. Sacrifice HP/DEF for more offensive stats.</p>
    </div>
  </div>

  <div class="insight-box" style="margin-top: 20px;">
    <h3>Summary: Is {c.name} Worth Building?</h3>
    <p>{c.description} With the right investment, {c.name} performs at a <strong>{c.rating}</strong> level in current content.</p>
  </div>

  {coreInsights[c.slug] && coreInsights[c.slug].weakness && (
    <div class="card" style="border-color:rgba(255,96,32,0.2);">
      <h3 style="color:#ff6020;">When NOT to use this character</h3>
      <p>{coreInsights[c.slug].weakness}</p>
    </div>
  )}

  {coreInsights[c.slug] && coreInsights[c.slug].controversy && (
    <div class="card" style="border-color:rgba(255,215,0,0.2);">
      <h3 style="color:#ffd700;">Community Controversy</h3>
      <p>{coreInsights[c.slug].controversy}</p>
    </div>
  )}

  {extendedGuides[c.slug] && (
    <div class="card" style="margin: 20px 0; border-color: rgba(96,128,255,0.15);">
      <h3 style="color: var(--accent);">In-Depth Guide</h3>
      <div style="white-space: pre-line; line-height: 1.8;">{extendedGuides[c.slug].guide}</div>
    </div>
  )}

  <div class="version-badge">Updated for Version 5.x</div>
  <h2>Best Build Overview</h2>
  <div class="quick-table">
    <div class="qrow qhead">
      <div>Slot</div>
      <div>Recommendation</div>
    </div>
    <div class="qrow">
      <div class="qlabel">Best Weapon</div>
      <div class="qvalue">{c.bestWeapon}</div>
    </div>
    <div class="qrow">
      <div class="qlabel">F2P Weapon</div>
      <div class="qvalue">{c.f2pWeapon}</div>
    </div>
    <div class="qrow">
      <div class="qlabel">Artifact Set</div>
      <div class="qvalue">{c.bestArtifacts}</div>
    </div>
    <div class="qrow">
      <div class="qlabel">Main Stats</div>
      <div class="qvalue">{c.mainStats}</div>
    </div>
    <div class="qrow">
      <div class="qlabel">Substat Priority</div>
      <div class="qvalue">{c.subStats}</div>
    </div>
    <div class="qrow">
      <div class="qlabel">Talent Priority</div>
      <div class="qvalue">{c.talentPriority}</div>
    </div>
    <div class="qrow">
      <div class="qlabel">Rating</div>
      <div class="qvalue">{c.rating}</div>
    </div>
  </div>
  <h2>Team Role</h2>
  <p>{c.teamRole}</p>
  <h2>Rotation Guide</h2>
  <p>{c.rotation}</p>

  <h2>Frequently Asked Questions</h2>
  {faq.map((f) => (
    <div class="card" style="margin: 12px 0; padding: 14px 18px;">
      <h3 style="margin-bottom: 6px; font-size: 1rem; color: var(--text-primary);">{f.q}</h3>
      <p style="margin: 0;">{f.a}</p>
    </div>
  ))}

  {relatedLists.length > 0 && (
    <div class="internal-links">
      <h3>Where {c.name} Ranks</h3>
      {
        relatedLists.map((b) => (
          <a href={`/best/${b.slug}/`}>{b.title}</a>
        ))
      }
    </div>
  )}

  <div class="internal-links">
    <h3>More {c.name} Guides</h3>
    <a href={"/build/" + c.slug + "/"}>{c.name} Best Build Guide</a>
    <a href={"/team/" + c.slug + "/"}>{c.name} Best Team Guide</a>
    <a href={`/element/${c.element.toLowerCase()}/`}>All {c.element} Characters →</a>
  </div>
</BaseLayout>

<style>
  .quick-table {
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    margin: 12px 0 20px;
  }
  .qrow {
    display: grid;
    grid-template-columns: 0.8fr 2.2fr;
    border-bottom: 1px solid var(--border);
  }
  .qrow:last-child { border-bottom: none; }
  .qhead {
    background: var(--bg-secondary);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--text-muted);
    font-weight: 700;
  }
  .qrow > div {
    padding: 10px 14px;
    font-size: 0.9rem;
  }
  .qlabel {
    color: var(--text-muted);
    font-weight: 600;
    border-right: 1px solid var(--border);
    font-size: 0.82rem;
  }
  .qvalue { color: var(--text-primary); }
  @media (max-width: 640px) {
    .qrow { grid-template-columns: 1fr; }
    .qlabel { border-right: none; border-bottom: 1px solid var(--border); }
  }
</style>