---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { characters } from "../../data/characters";
import { coreInsights } from "../../data/insights";
import { extendedGuides } from "../../data/extended-guides";
import { bestLists } from "../../data/best-lists";
import { comparisons } from "../../data/comparisons";
import { weaponGroups, artifactSets } from "../../data/gear";
import { characterTitle, characterDescription, roleLabel, article, shortPhrase, score } from "../../lib/seo";

export function getStaticPaths() {
  return characters.map((c) => ({
    params: { slug: c.slug },
    props: { character: c },
  }));
}

const { character: c } = Astro.props;
const slugify = (s) =>
  String(s || "").toLowerCase().replace(/['’]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
// Real weapon/artifact slugs come from src/data/gear.js (same slugify used by
// the weapon/artifact pages). Resolving against this set guarantees we never
// emit a 404 internal link for combo strings like "X / Y" or "X 4pc + 2pc Y".
const weaponSlugs = new Set(weaponGroups.flatMap((g) => g.weapons.map((w) => slugify(w.name))));
const artifactSlugs = new Set(artifactSets.map((a) => slugify(a.name)));
const resolveGear = (text, set) => {
  const n = slugify(text);
  if (set.has(n)) return n;
  for (const k of set) if (n.includes(k) && k.length > 2) return k;
  return null;
};
const wSlug = resolveGear(c.bestWeapon, weaponSlugs);
const aSlug = resolveGear(c.bestArtifacts, artifactSlugs);
const relatedLists = bestLists.filter((b) => b.items.some((i) => i.slug === c.slug));
const title = characterTitle(c);
const description = characterDescription(c);

// Head-to-head pages this character appears in. These used to be orphaned --
// 33 comparison pages with no internal links pointing at them.
const relatedComparisons = comparisons.filter(
  (x) => x.nameA.toLowerCase() === c.name.toLowerCase() || x.nameB.toLowerCase() === c.name.toLowerCase()
);
const rivalOf = (x) => (x.nameA.toLowerCase() === c.name.toLowerCase() ? x.nameB : x.nameA);
const jsonld = JSON.stringify({"@context":"https://schema.org","@type":"Article","headline":title,"description":description,"about":{"@type":"Thing","name":c.name}});
// Queries that include a year rank far better for this site than bare ones
// (avg position 11.2 vs 42.6 in Search Console), because the big wikis optimize
// for "mona build" and almost nobody targets "mona build 2026". Folding the
// year into H1 and two of the four FAQ questions widens that surface area
// without reading like keyword stuffing.
const YEAR = 2026;
const faq = [
  {
    q: "What is the best " + c.name + " build in " + YEAR + "?",
    a: "The best " + c.name + " build in " + YEAR + " uses " + c.bestWeapon + " with " + c.bestArtifacts + ". Main stats: " + c.mainStats + ". This setup maximizes their damage and keeps their rotation smooth."
  },
  {
    q: "Is " + c.name + " good in the current meta?",
    // The article agrees with the word that FOLLOWS it -- the role ("a pyro
    // main dps", "an electro sub-dps") -- not with the tier letter.
    a: "Yes — " + c.name + " scores " + score(c.rating) + " as " + article(roleLabel(c)) + " " + roleLabel(c).toLowerCase() +
      ", and fits into " + shortPhrase(c.strongTeam, 45) + "."
  },
  {
    q: "What is the best F2P weapon for " + c.name + "?",
    a: "The best free-to-play weapon for " + c.name + " is " + c.f2pWeapon + ". It provides competitive damage without requiring the weapon banner, making it a great budget option."
  },
  {
    q: "What is the best " + c.name + " team in " + YEAR + "?",
    a: "The strongest " + c.name + " team in " + YEAR + " is " + shortPhrase(c.strongTeam, 60) + ". " + shortPhrase(c.f2pTeam, 60) + " is the best budget alternative."
  },
  {
    q: "What are the best artifact main stats for " + c.name + "?",
    a: "Prioritize " + c.mainStats + " on " + c.name + "'s artifacts to maximize performance."
  },
  {
    q: "Who are the best teammates for " + c.name + "?",
    a: shortPhrase(c.strongTeam, 80)
  }
];
const faqJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map(f => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a }
  }))
});
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={jsonld}></script>
  <script type="application/ld+json" set:html={faqJsonLd}></script>
  <p>
    <span class={"tag tag-" + c.tier}>{c.tier}</span>
    <span class={"tag tag-" + c.element.toLowerCase()}>{c.element}</span>
    <span style="color: var(--text-muted);">{c.role} &middot; {c.weapon}</span>
  </p>
  <h1>Best {c.name} Build for {YEAR}</h1>

  <!-- Answer-first block. Google's featured snippet wants a single dense
       paragraph that resolves the query without scrolling, so the gear answer
       sits above the fold instead of at the bottom of the page. -->
  <div class="quick-answer">
    <p>
      <strong>{c.name}</strong> is {article("Tier")} Tier {c.tier} {roleLabel(c).toLowerCase()} in Genshin Impact.
      Best weapon: <strong>{c.bestWeapon}</strong>. Best artifacts: <strong>{c.bestArtifacts}</strong>.
      Best F2P weapon: <strong>{c.f2pWeapon}</strong>. Strongest team: {shortPhrase(c.strongTeam, 60)}.
      Rating: {score(c.rating)}.
    </p>
  </div>

  <h2>Best Build Overview</h2>
  <div class="quick-table">
    <div class="qrow qhead">
      <div>Slot</div>
      <div>Recommendation</div>
    </div>
    <div class="qrow">
      <div class="qlabel">Best Weapon</div>
      <div class="qvalue">{wSlug ? <a href={`/weapon/${wSlug}/`}>{c.bestWeapon}</a> : c.bestWeapon}</div>
    </div>
    <div class="qrow">
      <div class="qlabel">F2P Weapon</div>
      <div class="qvalue">{c.f2pWeapon}</div>
    </div>
    <div class="qrow">
      <div class="qlabel">Artifact Set</div>
      <div class="qvalue">{aSlug ? <a href={`/artifact/${aSlug}/`}>{c.bestArtifacts}</a> : c.bestArtifacts}</div>
    </div>
    <div class="qrow">
      <div class="qlabel">Main Stats</div>
      <div class="qvalue">{c.mainStats}</div>
    </div>
    <div class="qrow">
      <div class="qlabel">Substat Priority</div>
      <div class="qvalue">{c.subStats}</div>
    </div>
    <div class="qrow">
      <div class="qlabel">Talent Priority</div>
      <div class="qvalue">{c.talentPriority}</div>
    </div>
    <div class="qrow">
      <div class="qlabel">Rating</div>
      <div class="qvalue">{c.rating}</div>
    </div>
  </div>

  {coreInsights[c.slug] && (
    <div class="insight-box">
      <h3>Why This Build Works</h3>
      <p>{coreInsights[c.slug].whyItWorks}</p>
      <h3>Key Stat Threshold</h3>
      <p>{coreInsights[c.slug].keyThreshold}</p>
      <h3>Current Meta Status</h3>
      <p>{coreInsights[c.slug].metaStatus}</p>
    </div>
  )}

  <h2>Best {c.name} Teams in {YEAR}</h2>
  <p>{c.teamRole}</p>
  <div class="card">
    <h3>Strongest Team</h3>
    <p>{c.strongTeam}</p>
    <h3>Best F2P Team</h3>
    <p>{c.f2pTeam}</p>
  </div>

  <h2>Rotation Guide</h2>
  <p>{c.rotation}</p>

  <h2>Entry vs Endgame Build</h2>
  <div class="stat-grid">
    <div class="stat-card">
      <div class="stat-label">Entry Level Build</div>
      <div class="stat-value">{c.f2pWeapon}</div>
      <p style="margin-top: 4px;">Focus on main stat correctness. Set bonuses matter less than having correct main stats.</p>
    </div>
    <div class="stat-card">
      <div class="stat-label">Endgame Build</div>
      <div class="stat-value">{c.bestWeapon}</div>
      <p style="margin-top: 4px;">Optimize substats for perfect ratio. Sacrifice HP/DEF for more offensive stats.</p>
    </div>
  </div>

  <div class="insight-box" style="margin-top: 20px;">
    <h3>Summary: Is {c.name} Worth Building?</h3>
    <p>{c.description} With the right investment, {c.name} performs at a <strong>{c.rating}</strong> level in current content.</p>
  </div>

  {coreInsights[c.slug] && coreInsights[c.slug].weakness && (
    <div class="card" style="border-color:rgba(255,96,32,0.2);">
      <h3 style="color:#ff6020;">When NOT to use this character</h3>
      <p>{coreInsights[c.slug].weakness}</p>
    </div>
  )}

  {coreInsights[c.slug] && coreInsights[c.slug].controversy && (
    <div class="card" style="border-color:rgba(255,215,0,0.2);">
      <h3 style="color:#ffd700;">Community Controversy</h3>
      <p>{coreInsights[c.slug].controversy}</p>
    </div>
  )}

  {extendedGuides[c.slug] && (
    <div class="card" style="margin: 20px 0; border-color: rgba(96,128,255,0.15);">
      <h3 style="color: var(--accent);">In-Depth Guide</h3>
      <div style="white-space: pre-line; line-height: 1.8;">{extendedGuides[c.slug].guide}</div>
    </div>
  )}

  <div class="version-badge">Updated August 2026</div>

  <h2>Frequently Asked Questions</h2>
  {faq.map((f) => (
    <div class="card" style="margin: 12px 0; padding: 14px 18px;">
      <h3 style="margin-bottom: 6px; font-size: 1rem; color: var(--text-primary);">{f.q}</h3>
      <p style="margin: 0;">{f.a}</p>
    </div>
  ))}

  {relatedComparisons.length > 0 && (
    <div class="internal-links">
      <h3>{c.name} vs Other Characters</h3>
      {
        relatedComparisons.map((x) => (
          <a href={`/comparison/${x.slug}/`}>{c.name} vs {rivalOf(x)}</a>
        ))
      }
    </div>
  )}

  {relatedLists.length > 0 && (
    <div class="internal-links">
      <h3>Where {c.name} Ranks</h3>
      {
        relatedLists.map((b) => (
          <a href={`/best/${b.slug}/`}>{b.title}</a>
        ))
      }
    </div>
  )}

  <div class="internal-links">
    <h3>More {c.name} Guides</h3>
    <a href={"/build/" + c.slug + "/"}>{c.name} Best Build Guide</a>
    <a href={"/team/" + c.slug + "/"}>{c.name} Best Team Guide</a>
    <a href={`/element/${c.element.toLowerCase()}/`}>All {c.element} Characters →</a>
  </div>
</BaseLayout>

<style>
  .quick-answer {
    background: var(--bg-secondary);
    border-left: 3px solid var(--accent);
    border-radius: 0 10px 10px 0;
    padding: 14px 18px;
    margin: 14px 0 22px;
    line-height: 1.75;
    font-size: 0.95rem;
    color: var(--text-primary);
  }
  .quick-answer strong { color: var(--text-primary); }
  .quick-table {
    border: 1px solid var(--border);
    border-radius: 10px;
    overflow: hidden;
    margin: 12px 0 20px;
  }
  .qrow {
    display: grid;
    grid-template-columns: 0.8fr 2.2fr;
    border-bottom: 1px solid var(--border);
  }
  .qrow:last-child { border-bottom: none; }
  .qhead {
    background: var(--bg-secondary);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.6px;
    color: var(--text-muted);
    font-weight: 700;
  }
  .qrow > div {
    padding: 10px 14px;
    font-size: 0.9rem;
  }
  .qlabel {
    color: var(--text-muted);
    font-weight: 600;
    border-right: 1px solid var(--border);
    font-size: 0.82rem;
  }
  .qvalue { color: var(--text-primary); }
  @media (max-width: 640px) {
    .qrow { grid-template-columns: 1fr; }
    .qlabel { border-right: none; border-bottom: 1px solid var(--border); }
  }
</style>