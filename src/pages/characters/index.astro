---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { characters } from "../../data/characters";

const elements = ["Pyro", "Hydro", "Dendro", "Anemo", "Electro", "Geo", "Cryo"];
const metaTitle = "All Genshin Impact Characters — Build Guides & Tier List 2026";
const metaDescription =
  "Browse all Genshin Impact characters with build guides, best weapons, artifact sets, teams, and rotations. Filter by element and tier.";
---

<BaseLayout title={metaTitle} description={metaDescription}>
  <h1>All Genshin Impact Characters</h1>
  <p class="subtitle">
    Every character with a dedicated build guide, team guide, and rotation breakdown.
  </p>

  <div class="filter-row">
    <a class="filter-btn active" href="/characters/">All ({characters.length})</a>
    {
      elements.map((el) => (
        <a class="filter-btn" href={`/characters/#${el.toLowerCase()}`}>
          {el} ({characters.filter((c) => c.element === el).length})
        </a>
      ))
    }
  </div>

  {
    elements.map((el) => (
      <section id={el.toLowerCase()} style="margin-top: 28px;">
        <h2>{el} Characters</h2>
        <ul class="character-list">
          {characters
            .filter((c) => c.element === el)
            .map((c) => (
              <li>
                <a href={`/character/${c.slug}/`}>
            <span class={"avatar avatar-" + c.element.toLowerCase()}>{c.name.charAt(0)}</span>
                  <span class={"tag tag-" + c.tier}>{c.tier}</span>
                  <span class={"tag tag-" + c.element.toLowerCase()}>{c.element}</span>
                  <span class="char-name">{c.name}</span>
                  <span class="desc">{c.role}</span>
                </a>
              </li>
            ))}
        </ul>
      </section>
    ))
  }

  <div class="internal-links">
    <h3>Explore More</h3>
    <a href="/builds/">All Build Guides →</a>
    <a href="/teams/">All Team Guides →</a>
    <a href="/comparisons/">Character Comparisons →</a>
  </div>
</BaseLayout>
