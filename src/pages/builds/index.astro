---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { characters } from "../../data/characters";

const metaTitle = "Genshin Impact Best Builds 2026 — Weapons, Artifacts & Stats";
const metaDescription =
  "Best build guides for every Genshin Impact character: best weapon, F2P weapon, artifact set, main stats, substats, and talent priority.";
---

<BaseLayout title={metaTitle} description={metaDescription}>
  <h1>Best Builds</h1>
  <p class="subtitle">
    Best-in-slot weapons, F2P alternatives, artifact sets, stat priorities, and talent order for
    every character.
  </p>

  <ul class="character-list">
    {
      characters.map((c) => (
        <li>
          <a href={`/build/${c.slug}/`}>
            <span class={"avatar avatar-" + c.element.toLowerCase()}>{c.name.charAt(0)}</span>
            <span class={"tag tag-" + c.tier}>{c.tier}</span>
            <span class={"tag tag-" + c.element.toLowerCase()}>{c.element}</span>
            <span class="char-name">{c.name}</span>
            <span class="desc">{c.bestWeapon}</span>
          </a>
        </li>
      ))
    }
  </ul>

  <div class="internal-links">
    <h3>Explore More</h3>
    <a href="/characters/">All Characters →</a>
    <a href="/teams/">All Team Guides →</a>
  </div>
</BaseLayout>
