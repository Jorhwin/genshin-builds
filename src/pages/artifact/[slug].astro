---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { artifactSets } from "../../data/gear";
import { artifactTips } from "../../data/artifact-tips";
import { characters } from "../../data/characters";

const slugify = (s) =>
  s
    .toLowerCase()
    .replace(/['’]/g, "")
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/(^-|-$)/g, "");

export function getStaticPaths() {
  const slug = (s) =>
    s
      .toLowerCase()
      .replace(/['’]/g, "")
      .replace(/[^a-z0-9]+/g, "-")
      .replace(/(^-|-$)/g, "");
  return artifactSets.map((a) => ({
    params: { slug: slug(a.name) },
    props: { set: a },
  }));
}

const { set } = Astro.props;
const title = set.name + " — Best Characters, Set Bonus & Is It Worth Farming (2026)";
const description =
  set.name + " artifact set guide: who should use it, how the set bonus works, and the situations where it is the wrong choice. " + set.why;

const nameToSlug = new Map();
for (const c of characters) {
  nameToSlug.set(c.name.toLowerCase(), c.slug);
  nameToSlug.set(c.name.toLowerCase().replace(/\s*\(.*\)\s*/g, "").trim(), c.slug);
}
const resolveChar = (n) => {
  const key = n.toLowerCase().trim();
  if (nameToSlug.has(key)) return nameToSlug.get(key);
  const noParens = key.replace(/\s*\(.*\)\s*/g, "").trim();
  return nameToSlug.get(noParens) || null;
};

const bestFor = set.bestFor.split(",").map((s) => s.trim()).filter(Boolean);
const siblings = artifactSets.filter((a) => a.name !== set.name).slice(0, 8);
const tip = artifactTips[set.name] || "";

const articleJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "Article",
  headline: title,
  description: description,
  about: { "@type": "Thing", name: set.name },
});

const faq = [
  {
    q: "Who should use " + set.name + "?",
    a: "It is best on " + set.bestFor + ". " + set.why,
  },
  {
    q: "Is " + set.name + " worth farming?",
    a:
      "Farm it if one of the characters above is a core part of your team. " +
      set.caveat +
      " If nobody in your roster uses it, your resin is better spent on a set that serves your carries.",
  },
  {
    q: "Does " + set.name + " work at two pieces?",
    a:
      "Two pieces still gives a useful stat bonus, and mixing 2-piece combinations is often the right call before you complete the four-piece. Correct main stats with an off-set piece usually beat a completed set with the wrong main stats.",
  },
];

const faqJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faq.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
});
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={articleJsonLd}></script>
  <script type="application/ld+json" set:html={faqJsonLd}></script>

  <p><span class="tag tag-S" style="background:#40a06033;color:#40c060;">Artifact Set</span></p>
  <h1>{set.name}</h1>
  <p class="subtitle">{set.why}</p>

  <div class="insight-box">
    <h3>Before you farm this set</h3>
    <p>
      {set.caveat}
    </p>
  </div>

  <h2>Best Characters for {set.name}</h2>
  <ul class="character-list" style="grid-template-columns: 1fr;">
    {
      bestFor.map((n) => {
        const slug = resolveChar(n);
        return (
          <li>
            {slug ? (
              <a href={`/character/${slug}/`}>
                <span class="char-name">{n}</span>
                <span class="desc">{n} build guide →</span>
              </a>
            ) : (
              <span style="display:block;padding:12px 16px;color:var(--text-secondary);">{n}</span>
            )}
          </li>
        );
      })
    }
  </ul>

  {tip && (
    <div class="insight-box">
      <h3>How to get the most out of it</h3>
      <p>{tip}</p>
    </div>
  )}

  <h2>Other Artifact Sets</h2>
  <div class="mini-grid">
    {
      siblings.map((a) => (
        <a href={`/artifact/${slugify(a.name)}/`}>{a.name}</a>
      ))
    }
  </div>

  <h2>Frequently Asked Questions</h2>
  {
    faq.map((f) => (
      <div class="card" style="margin: 12px 0; padding: 14px 18px;">
        <h3 style="margin-bottom: 6px; font-size: 1rem; color: var(--text-primary);">{f.q}</h3>
        <p style="margin: 0;">{f.a}</p>
      </div>
    ))
  }

  <div class="internal-links">
    <h3>Related Guides</h3>
    <a href="/artifacts/">All Best Artifact Sets →</a>
    <a href="/weapons/">Best Weapons by Type →</a>
    <a href="/characters/">All Characters →</a>
    <a href="/best/">Best Characters &amp; Teams →</a>
  </div>
</BaseLayout>
