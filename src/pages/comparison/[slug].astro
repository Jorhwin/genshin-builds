---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { comparisons } from "../../data/comparisons";
import { characters } from "../../data/characters";
import { weaponGroups } from "../../data/gear";
import { comparisonTitle } from "../../lib/seo";

export function getStaticPaths() {
  return comparisons.map((c) => ({
    params: { slug: c.slug },
    props: { comp: c },
  }));
}

const { comp: c } = Astro.props;
const title = comparisonTitle(c);
const description = c.seoDesc;
const kind = c.kind || "character";

const slugify = (s) =>
  s.toLowerCase().replace(/['’]/g, "").replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");

// Character name -> slug (never guess — guessed slugs 404)
const byName = new Map();
for (const ch of characters) {
  byName.set(ch.name.toLowerCase(), ch.slug);
  byName.set(ch.name.toLowerCase().replace(/\s*\(.*\)\s*/g, "").trim(), ch.slug);
  byName.set(ch.slug, ch.slug);
}
const resolveChar = (name) => {
  if (!name) return null;
  const key = name.toLowerCase().trim();
  if (byName.has(key)) return byName.get(key);
  const noParens = key.replace(/\s*\(.*\)\s*/g, "").trim();
  if (byName.has(noParens)) return byName.get(noParens);
  const guess = key.replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "");
  if (byName.has(guess)) return byName.get(guess);
  return null;
};

// Weapon name -> slug (only used for kind === "weapon")
const weaponSlugMap = new Map();
for (const g of weaponGroups) {
  for (const w of g.weapons) {
    const ws = slugify(w.name);
    weaponSlugMap.set(w.name.toLowerCase(), ws);
    weaponSlugMap.set(w.name.toLowerCase().replace(/\s*\(.*\)\s*/g, "").trim(), ws);
  }
}
const resolveWeapon = (name) => {
  if (!name) return null;
  const key = name.toLowerCase().trim();
  return weaponSlugMap.has(key) ? weaponSlugMap.get(key) : null;
};

const slugA = kind === "weapon" ? resolveWeapon(c.nameA) : resolveChar(c.nameA);
const slugB = kind === "weapon" ? resolveWeapon(c.nameB) : resolveChar(c.nameB);
const linkA = slugA ? (kind === "weapon" ? `/weapon/${slugA}/` : `/character/${slugA}/`) : null;
const linkB = slugB ? (kind === "weapon" ? `/weapon/${slugB}/` : `/character/${slugB}/`) : null;

const faqJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "Is " + c.nameA + " or " + c.nameB + " better?",
      acceptedAnswer: { "@type": "Answer", text: c.verdict }
    }
  ]
});
---

<BaseLayout title={title} description={description}>
  <script type="application/ld+json" set:html={faqJsonLd}></script>
  <p>
    {
      kind === "weapon" ? (
        <span class="tag" style="background:rgba(160,64,255,0.1);color:#c48aff;border:1px solid rgba(160,64,255,0.2);">{c.element}</span>
      ) : (
        <span class={"tag tag-" + c.element.toLowerCase()}>{c.element}</span>
      )
    }
    <span style="color: var(--text-muted); font-size: 0.9rem;">{kind === "weapon" ? "Weapon Comparison" : "Character Comparison"}</span>
  </p>

  <h1>{c.nameA} vs {c.nameB}</h1>
  <p class="subtitle">{c.summary}</p>

  <div class="comparison-header">
    <div class="comp-card comp-a">
      <div class="comp-label">VS</div>
      <div class="comp-name">{c.nameA}</div>
    </div>
    <div class="comp-card comp-b">
      <div class="comp-label">VS</div>
      <div class="comp-name">{c.nameB}</div>
    </div>
  </div>

  {c.categories.map((cat) => (
    <div>
      <h2>{cat.name}</h2>
      <div class="comp-table">
        <div class="comp-row header-row">
          <div class="comp-cell">{c.nameA}</div>
          <div class="comp-cell winner-col"></div>
          <div class="comp-cell">{c.nameB}</div>
        </div>
        {cat.items.map((item) => (
          <div class="comp-row">
            <div class={`comp-cell ${item.winner === "A" ? "winner" : ""}`}>{item.a}</div>
            <div class="comp-cell winner-badge-cell">
              {item.winner === "A" ? <span class="winner-badge" style="background: #6080ff33; color: #6080ff;">✓ {c.nameA.split(" ")[0]}</span> : item.winner === "B" ? <span class="winner-badge" style="background: #ff602033; color: #ff6020;">✓ {c.nameB.split(" ")[0]}</span> : <span class="winner-badge" style="background: #60608033; color: #8080a0;">— Even</span>}
            </div>
            <div class={`comp-cell ${item.winner === "B" ? "winner" : ""}`}>{item.b}</div>
          </div>
        ))}
      </div>
    </div>
  ))}

  <div class="insight-box" style="margin-top: 28px;">
    <h3>🎯 Verdict</h3>
    <p>{c.verdict}</p>
  </div>


  <h2>Which One Should You Choose?</h2>
  <div class="card" style="margin: 16px 0;">
    <p>{c.verdict}</p>
    <p style="margin-top: 10px;">Consider your account when deciding. Look at the units and weapons you already own, the teams you already have built, and the content you struggle with most. Both {c.nameA} and {c.nameB} are strong — the right choice depends on which fills a bigger gap in your roster.</p>
  </div>

  <h2>Frequently Asked Questions</h2>
  <div class="card" style="margin: 12px 0; padding: 14px 18px;">
    <h3 style="margin-bottom: 6px; font-size: 1rem; color: var(--text-primary);">Is {c.nameA} or {c.nameB} better?</h3>
    <p style="margin: 0;">There is no universal answer — {c.nameA} wins in {c.categories.map(cat => cat.name).join(" and ").replace(/,([^,]*)$/, " and$1")} scenarios where their kit shines, while {c.nameB} is stronger in others. Use the comparison tables above to match each option's strengths to your specific needs.</p>
  </div>
  <div class="card" style="margin: 12px 0; padding: 14px 18px;">
    <h3 style="margin-bottom: 6px; font-size: 1rem; color: var(--text-primary);">Which one is better for F2P players?</h3>
    <p style="margin: 0;">Both options are viable at base constellation with their F2P alternatives. Check each option's dedicated guide for the best budget builds and teams to see which one fits your account's current roster.</p>
  </div>

  <div class="internal-links">
    <h3>📂 Related Guides</h3>
    {
      linkA ? (
        <a href={linkA}>📋 {c.nameA} Guide →</a>
      ) : (
        <span style="display:block;padding:8px 12px;color:var(--text-muted);">{c.nameA}</span>
      )
    }
    {
      linkB ? (
        <a href={linkB}>📋 {c.nameB} Guide →</a>
      ) : (
        <span style="display:block;padding:8px 12px;color:var(--text-muted);">{c.nameB}</span>
      )
    }
    <a href="/characters/">🏠 All Characters</a>
    <a href="/comparisons/">📊 All Comparisons →</a>
  </div>
</BaseLayout>

<style>
  .comparison-header {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin: 20px 0;
  }
  .comp-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 20px;
    text-align: center;
    position: relative;
  }
  .comp-a { border-color: rgba(96, 128, 255, 0.3); }
  .comp-b { border-color: rgba(255, 96, 32, 0.3); }
  .comp-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--text-muted);
    margin-bottom: 4px;
  }
  .comp-name {
    font-size: 1.2rem;
    font-weight: 700;
    color: var(--text-primary);
  }
  .comp-table {
    border-radius: 10px;
    overflow: hidden;
    border: 1px solid var(--border);
    margin: 12px 0;
  }
  .comp-row {
    display: grid;
    grid-template-columns: 1.8fr 0.6fr 1.8fr;
    border-bottom: 1px solid var(--border);
  }
  .comp-row:last-child { border-bottom: none; }
  .comp-row.header-row {
    background: var(--bg-secondary);
    font-weight: 600;
    font-size: 0.8rem;
    color: var(--text-muted);
    text-transform: uppercase;
  }
  .comp-cell {
    padding: 10px 12px;
    font-size: 0.85rem;
    color: var(--text-secondary);
    border-right: 1px solid var(--border);
  }
  .comp-cell:last-child { border-right: none; }
  .comp-cell.winner { color: var(--text-primary); font-weight: 500; }
  .winner-badge-cell { display: flex; align-items: center; justify-content: center; }
  .winner-badge {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 10px;
    font-size: 0.7rem;
    font-weight: 600;
  }
  @media (max-width: 640px) {
    .comp-row { grid-template-columns: 1fr 0.5fr 1fr; }
    .comp-cell { font-size: 0.78rem; padding: 8px 6px; }
  }
</style>
